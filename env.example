#--------------------------------------------------------------------
# SATVIKDAAN - Donor & Beneficiary Management System
# Copy this file's values into your own .env (this file itself is
# gitignored - never commit real secrets).
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://donors.satvikdaan.org/'
app.appTimezone = 'Asia/Kolkata'
app.CSPEnabled = false

#--------------------------------------------------------------------
# ORGANISATION (used on tax receipts / e-mails - see app/Common.php org())
#--------------------------------------------------------------------
ORG_NAME    = 'Satvikdaan Foundation'
ORG_ADDRESS = '123 Seva Marg, Jaipur, Rajasthan 302001, India'
ORG_EMAIL   = accounts@satvikdaan.org
ORG_PHONE   = '+91 141 000 0000'
ORG_PAN     = AAAAA0000A
ORG_80G_NO  = 'AABTS0000A20231'

#--------------------------------------------------------------------
# DATABASE  (mysql -u root -p < database/satvikdaan.sql   creates the schema + demo user)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = satvikdaan
database.default.username = satvikdaan_app
database.default.password = 'CHANGE_ME_STRONG_PASSWORD'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION  (AES-256 field encryption for beneficiary PII - app/Libraries/Crypto.php)
# Generate a fresh key for every deployment:   php spark key:generate
# BACK THIS KEY UP SEPARATELY. If it is lost, encrypted PII cannot be recovered.
#--------------------------------------------------------------------
encryption.key =
encryption.driver = OpenSSL

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = CodeIgniter\Session\Handlers\FileHandler
session.cookieName = sd_session
session.expiration = 7200
session.savePath = null
session.matchIP = false

#--------------------------------------------------------------------
# EMAIL (SMTP) - used for donor receipts, thank-you letters, stewardship e-mails
#--------------------------------------------------------------------
email.fromEmail  = 'no-reply@satvikdaan.org'
email.fromName   = 'Satvikdaan Foundation'
email.protocol   = smtp
email.SMTPHost   = smtp.yourprovider.com
email.SMTPUser   = 'no-reply@satvikdaan.org'
email.SMTPPass   = 'CHANGE_ME'
email.SMTPPort   = 587
email.SMTPCrypto = tls
email.mailType   = html
email.charset    = UTF-8
email.wordWrap   = true

#--------------------------------------------------------------------
# RAZORPAY (online giving) - https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET must stay server-side only.
# Webhook: Razorpay Dashboard -> Settings -> Webhooks -> URL = {baseURL}razorpay/webhook, event: payment.captured, payment.failed
#--------------------------------------------------------------------
RAZORPAY_KEY_ID        = rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET    = CHANGE_ME
RAZORPAY_WEBHOOK_SECRET = CHANGE_ME

#--------------------------------------------------------------------
# WHATSAPP (Meta WhatsApp Business Cloud API) - optional, for donor stewardship
#--------------------------------------------------------------------
WHATSAPP_TOKEN    =
WHATSAPP_PHONE_ID =

#--------------------------------------------------------------------
# CLAUDE / ANTHROPIC (optional) - powers the AI re-engagement draft generator
# in Donor Stewardship. Leave blank to use the built-in template writer instead.
#--------------------------------------------------------------------
ANTHROPIC_API_KEY = 
ANTHROPIC_MODEL    = claude-sonnet-5
